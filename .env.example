
# ── Location ───────────────────────────────────────────────────────────────
# The timezone the vans and the calendars live in. Every slot is computed in this
# zone; the browser's timezone is never used. Defaults to America/New_York.
BOOKING_TIMEZONE=America/New_York

# Stable public origin used when signed member and crew links are generated.
PUBLIC_APP_URL=https://l-b-lyart.vercel.app

# ── HighLevel ──────────────────────────────────────────────────────────────
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=
GHL_CONFIRMED_PIPELINE_STAGE_ID=
GHL_ASSIGNED_USER_ID=

# One calendar per van. A multi-vehicle booking is assigned straight onto these,
# never onto a general round-robin calendar — round robin would be free to put two
# of the four vehicles on the same van. All four are required.
GHL_CALENDAR_CAMIONETA_1=
GHL_CALENDAR_CAMIONETA_2=
GHL_CALENDAR_CAMIONETA_3=
GHL_CALENDAR_CAMIONETA_4=

# Setup-script only, never read at runtime: the four van user ids, comma separated.
# Used exclusively by `node scripts/setup-ghl.mjs --create-van-calendars` to create
# the four calendars above when they do not exist yet.
GHL_VAN_USER_IDS=

# Legacy single round-robin calendar. Unused by the agenda; kept only so older
# tooling that reads it keeps working.
GHL_CALENDAR_ID=

# Optional Inbound Webhook that a workflow listens to after each booking.
GHL_BOOKING_WEBHOOK_URL=

# ── Payments ───────────────────────────────────────────────────────────────
# A booking is confirmed ONLY by a verified payment event on /api/payments/webhook.
# This secret authenticates that endpoint: either as an HMAC-SHA256 hex digest of
# the raw body in X-LyB-Signature, or as `Authorization: Bearer <secret>` for
# HighLevel workflows, which cannot sign a body. Required for the endpoint to work.
PAYMENT_WEBHOOK_SECRET=

# Online deposit collection. Off unless set to exactly "on"; when off no payment
# link is created and bookings stay pending until the office records a payment.
GHL_DEPOSIT_PAYMENTS=

# Set to exactly "true" to charge the deposit in LIVE mode through the payment
# processor connected to the HighLevel sub-account. Any other value (including
# unset) uses TEST mode, so turning GHL_DEPOSIT_PAYMENTS
# on can never move real money by accident.
GHL_DEPOSIT_LIVE_MODE=

# ── Hold expiry sweeper ────────────────────────────────────────────────────
# Bearer token for /api/bookings/expire, which releases holds older than 15
# minutes. Vercel Cron sends this automatically when CRON_SECRET is set (see the
# crons entry in vercel.json). Without it the endpoint returns 503 rather than
# letting anyone release live holds.
CRON_SECRET=

# ── Signed links (crew panel and member page) ───────────────────────────────
# Two audiences, two secrets, on purpose: a crew link can never be replayed as a
# member link, and rotating one audience's secret leaves the other's links working.
# Each must be at least 32 characters; the code refuses to sign with anything
# shorter rather than falling back to a default. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Rotating either one invalidates ALL links of that kind at once — that is the only
# revocation there is, since nothing is stored.
MEMBER_LINK_SECRET=

# ── Crew panel ──────────────────────────────────────────────────────────────
# Signs the standing link each van's crew keeps on their phone
# (cuadrilla.html?t=…). At least 32 characters; the code refuses to sign with
# anything shorter rather than falling back to a default, because a default would
# mean every deployment shares a signing key.
#
# Rotating this invalidates ALL four links at once — that is the only revocation
# there is, since nothing is stored. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CREW_LINK_SECRET=

# ── Memberships ─────────────────────────────────────────────────────────────
# Recurring billing runs on HighLevel's own recurring invoices, so there is no
# payment-provider key here. Stripe was removed on 2026-08-04 to keep every sale
# recorded in one place — see DISENO-SIN-BASE-DE-DATOS.md.

# ── CRM catalog provisioning ───────────────────────────────────────────────
# Bearer token for POST /api/internal/dependencies, the operator-only
# endpoint that creates the CRM service catalog (products and prices). It refuses
# to do anything without both this secret and an explicit `{ apply: true }`, and it
# only ever touches objects carrying its own catalog marker — the pre-existing
# $30/$50 deposit products are out of its reach by construction.
MEMBERSHIP_PROVISION_SECRET=

# ── CRM recurring-membership test probe ────────────────────────────────────
# Bearer token for the operator-only test endpoint. It creates only a DND
# synthetic contact and an UNSCHEDULED HighLevel invoice draft with
# `liveMode:false`; it never sends an invoice or opens a live checkout.
MEMBERSHIP_TEST_SECRET=

# Reserved for the later, separately approved production activation of native
# CRM recurring invoices. Keep unset or false during testing. This is distinct
# from GHL_DEPOSIT_LIVE_MODE and cannot change the $30/$50 deposit behavior.
GHL_MEMBERSHIP_LIVE_MODE=

# ── Notification workflows ─────────────────────────────────────────────────
# HighLevel inbound-workflow URLs, one per channel. Every outbound message is
# recorded in notification_deliveries with a unique dedupe key first, so a
# redelivery or a HighLevel retry can never send a second SMS, email or internal
# notice. An unset endpoint means the message is RECORDED but not delivered —
# visible in the table rather than silently dropped.
GHL_WORKFLOW_SMS_URL=
GHL_WORKFLOW_EMAIL_URL=
GHL_WORKFLOW_INTERNAL_URL=
GHL_WORKFLOW_WEBHOOK_URL=

# ── Office actions ─────────────────────────────────────────────────────────
# Bearer token for the membership actions that change what a customer owes —
# marking a visit complete, cancelled or a no-show. Customers must not be able to
# call these: a customer could otherwise turn their own no-show into a free
# cancellation. Booking and confirming stay same-origin and need no token.
OFFICE_API_TOKEN=
