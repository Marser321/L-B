# Server-only configuration. Never commit real values.

# ── Booking database ───────────────────────────────────────────────────────
# Postgres is the source of truth for what van is busy when. Without it the
# booking endpoints return 503 — they never fall back to reading availability off
# HighLevel, because a calendar the office edits by hand cannot be an authority.
# Run `npm install && npm run migrate` once after setting this.
DATABASE_URL=
DATABASE_POOL_MAX=3
DATABASE_STATEMENT_TIMEOUT_MS=8000

# ── Location ───────────────────────────────────────────────────────────────
# The timezone the vans and the calendars live in. Every slot is computed in this
# zone; the browser's timezone is never used. Defaults to America/New_York.
BOOKING_TIMEZONE=America/New_York

# ── HighLevel ──────────────────────────────────────────────────────────────
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=
GHL_CONFIRMED_PIPELINE_STAGE_ID=
GHL_ASSIGNED_USER_ID=

# One calendar per van. A multi-vehicle booking is assigned straight onto these,
# never onto a general round-robin calendar — round robin would be free to put two
# of the four vehicles on the same van. All four are required.
GHL_CALENDAR_CAMIONETA_1=
GHL_CALENDAR_CAMIONETA_2=
GHL_CALENDAR_CAMIONETA_3=
GHL_CALENDAR_CAMIONETA_4=

# Legacy single round-robin calendar. Unused by the agenda; kept only so older
# tooling that reads it keeps working.
GHL_CALENDAR_ID=

# Optional Inbound Webhook that a workflow listens to after each booking.
GHL_BOOKING_WEBHOOK_URL=

# ── Payments ───────────────────────────────────────────────────────────────
# A booking is confirmed ONLY by a verified payment event on /api/payments/webhook.
# This secret authenticates that endpoint: either as an HMAC-SHA256 hex digest of
# the raw body in X-LyB-Signature, or as `Authorization: Bearer <secret>` for
# HighLevel workflows, which cannot sign a body. Required for the endpoint to work.
PAYMENT_WEBHOOK_SECRET=

# Online deposit collection. Off unless set to exactly "on"; when off no payment
# link is created and bookings stay pending until the office records a payment.
GHL_DEPOSIT_PAYMENTS=

# Set to exactly "true" to charge the deposit through Stripe LIVE mode. Any other
# value (including unset) uses Stripe TEST mode, so turning GHL_DEPOSIT_PAYMENTS
# on can never move real money by accident.
GHL_DEPOSIT_LIVE_MODE=

# ── Hold expiry sweeper ────────────────────────────────────────────────────
# Bearer token for /api/bookings/expire, which releases holds older than 15
# minutes. Vercel Cron sends this automatically when CRON_SECRET is set (see the
# crons entry in vercel.json). Without it the endpoint returns 503 rather than
# letting anyone release live holds.
CRON_SECRET=

# ── Memberships (Stripe recurring billing) ─────────────────────────────────
# See MEMBERSHIPS.md. Stripe is the processor; Postgres is still the source of
# truth for what a customer is owed.
#
# The secret key also decides live vs test mode: nothing else can. A key starting
# sk_live_ puts the whole module in live mode, and the provisioner then demands
# two extra flags before it will create anything.
STRIPE_SECRET_KEY=

# Endpoint signing secret for /api/webhooks/stripe (starts whsec_). A membership
# is activated, credits granted, or an account marked past due ONLY by an event
# that verifies against this. Without it the endpoint returns 503.
STRIPE_WEBHOOK_SECRET=

# Where Stripe Checkout returns the customer. Both optional; sensible defaults are
# used when unset.
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=

# ── Notification workflows ─────────────────────────────────────────────────
# HighLevel inbound-workflow URLs, one per channel. Every outbound message is
# recorded in notification_deliveries with a unique dedupe key first, so a Stripe
# redelivery or a HighLevel retry can never send a second SMS, email or internal
# notice. An unset endpoint means the message is RECORDED but not delivered —
# visible in the table rather than silently dropped.
GHL_WORKFLOW_SMS_URL=
GHL_WORKFLOW_EMAIL_URL=
GHL_WORKFLOW_INTERNAL_URL=
GHL_WORKFLOW_WEBHOOK_URL=

# ── Office actions ─────────────────────────────────────────────────────────
# Bearer token for the membership actions that change what a customer owes —
# marking a visit complete, cancelled or a no-show. Customers must not be able to
# call these: a customer could otherwise turn their own no-show into a free
# cancellation. Booking and confirming stay same-origin and need no token.
OFFICE_API_TOKEN=
