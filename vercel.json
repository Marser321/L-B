{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/bookings/expire",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    { "source": "/c/:token", "destination": "/cuadrilla?t=:token" },
    { "source": "/m/:token", "destination": "/mi-membresia?t=:token" }
  ]
}
